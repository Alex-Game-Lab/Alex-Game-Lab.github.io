# Copy to /etc/agl-bots.env on the selected server and edit there.
# Obtain two separate tokens in @BotFather. Never commit real tokens.
PERSONAL_BOT_TOKEN=REPLACE_WITH_PERSONAL_BOT_TOKEN
AGL_BOT_TOKEN=REPLACE_WITH_AGL_BOT_TOKEN
# 0 enables setup mode; /id returns the sender's own Telegram ID.
# Start both bots from the owner's account before enabling delivery.
OWNER_CHAT_ID=0
BOT_DATA_DIR=/var/lib/agl-bots

